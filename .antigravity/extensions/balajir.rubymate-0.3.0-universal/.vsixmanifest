<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="rubymate" Version="0.3.0" Publisher="BalajiR" />
			<DisplayName>Ruby - Complete Ruby and Rails Extension - (RubyMate)</DisplayName>
			<Description xml:space="preserve">The ultimate Ruby and Rails extension for VS Code. Features: Solargraph IntelliSense, Visual Debugger (rdbg), Test Explorer for RSpec &amp; Minitest, Rails Navigation, ERB/Haml/Slim Template Intelligence with path helpers, RuboCop Auto-format, Go to Definition, Find All References, Code Completion, Syntax Highlighting, and Smart ActiveRecord Intelligence</Description>
			<Tags>ruby,rails,ruby extension,ruby vscode,ruby on rails,ruby support,ruby language,ruby intellisense,ruby ide,ruby debugger,ruby debug,solargraph,rspec,minitest,ruby test,test explorer,ruby testing,rubocop,ruby formatter,ruby linter,ruby autocomplete,ruby code completion,rails ide,rails development,rails debugger,rails testing,activerecord,ruby navigation,go to definition,find references,code intelligence,ruby tools,rails tools,erb,erb intellisense,haml,slim,rails templates,rails helpers,path helpers,bundler,gem,rake,ruby snippets,rails snippets,ruby syntax,syntax highlighting,ruby refactoring,rails navigation,rails generator,ruby workspace,ruby development,snippet,keybindings,debuggers,Ruby,__ext_rb,__ext_rake,__ext_gemspec,__ext_Rakefile,__ext_Gemfile,ERB,EmbeddedRuby,__ext_erb,__ext_html.erb,__ext_text.erb,Haml,__ext_haml,__ext_html.haml,Slim,__ext_slim,__ext_html.slim</Tags>
			<Categories>Programming Languages,Debuggers,Snippets,Formatters,Testing,Linters</Categories>
			<GalleryFlags>Public</GalleryFlags>
			<Badges><Badge Link="https://marketplace.visualstudio.com/items?itemName=BalajiR.rubymate" ImgUri="https://img.shields.io/visual-studio-marketplace/v/BalajiR.rubymate" Description="Version" />
<Badge Link="https://marketplace.visualstudio.com/items?itemName=BalajiR.rubymate" ImgUri="https://img.shields.io/visual-studio-marketplace/i/BalajiR.rubymate" Description="Installs" /></Badges>
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.85.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
