{
	"name": "code-sight-vscode",
	"publisher": "blackduck",
	"displayName": "Code Sight (Security)",
	"description": "Find and fix security and quality issues in source code and open source dependencies before you commit.",
	"version": "2026.4.0",
	"repository": {},
	"icon": "resources/icons/extension-logo.png",
	"license": "SEE LICENSE IN LICENSE",
	"engines": {
		"vscode": "^1.78.0",
		"node": ">=18.19.1 <= 18.99.99",
		"npm": ">=10.2.4 <= 10.99.99"
	},
	"homepage": "https://www.blackduck.com",
	"keywords": [
		"SAST",
		"Security",
		"Blackduck",
		"Coverity",
		"Codesight",
		"Code Sight",
		"SCA",
		"Static analysis",
		"Software composition analysis",
		"Open source analysis",
		"Black Duck",
		"Analysis"
	],
	"categories": [
		"Programming Languages",
		"Linters",
		"Testing",
		"Debuggers",
		"Education",
		"Other"
	],
	"qna": false,
	"activationEvents": [
		"*"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"chatParticipants": [
			{
				"id": "codesight-scan-helper.codesight",
				"fullName": "Black Duck Assist",
				"name": "blackduck-assist",
				"description": "Try '/code-sight-getting-started'",
				"isSticky": true,
				"commands": [
					{
						"name": "code-sight-getting-started",
						"description": "Get started with Code Sight"
					},
					{
						"name": "code-sight-configure-coverity-scan",
						"description": "Start scanning with Coverity"
					},
					{
						"name": "code-sight-configure-polaris-scan",
						"description": "Start scanning with Polaris"
					},
					{
						"name": "code-sight-configure-rapid-scan-static-scan",
						"description": "Start scanning with Rapid Scan Static"
					},
					{
						"name": "code-sight-configure-black-duck-sca-scan",
						"description": "Start scanning with Black Duck SCA"
					},
					{
						"name": "code-sight-view-polaris-server-issues",
						"description": "View Polaris issues in Code Sight"
					},
					{
						"name": "code-sight-view-coverity-server-issues",
						"description": "View Coverity issues in Code Sight"
					}
				]
			}
		],
		"colors": [
			{
				"id": "codesight.signal.foreground",
				"description": "Signal issue text color",
				"defaults": {
					"dark": "#D3AF37",
					"light": "#9E892B"
				}
			}
		],
