			},
			{
				"command": "codesight.show.local.view.markers",
				"title": "%command.codesight.show.local.view.markers.title%",
				"icon": {
					"dark": "resources/icons/toggle-team-view-dark.svg",
					"light": "resources/icons/toggle-team-view-light.svg"
				},
				"when": "codesight.setupComplete && codesight.localViewMarkers && codesight.editorMarkersEnabled && codesight.isEditorMarkersEnabledFromSettings && codesight.hasLocalViewResults"
			},
			{
				"command": "codesight.show.team.view.markers",
				"title": "%command.codesight.show.team.view.markers.title%",
				"icon": {
					"dark": "resources/icons/toggle-local-view-dark.svg",
					"light": "resources/icons/toggle-local-view-light.svg"
