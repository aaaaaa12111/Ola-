				"enablement": "codesight.setupComplete && !codesight.teamViewSimpleView",
				"icon": {
					"dark": "resources/icons/file-filter-dark.svg",
					"light": "resources/icons/file-filter-light.svg"
				}
			},
			{
				"command": "codesight.teamViewFilterView.enableActiveFileFilter",
				"title": "%command.codesight.enableActiveFileFilter%",
				"enablement": "codesight.setupComplete && !codesight.teamViewSimpleView",
				"icon": {
					"dark": "resources/icons/file-filter-hollow-dark.svg",
					"light": "resources/icons/file-filter-hollow-light.svg"
				}
			},
			{
				"command": "codesight.lock.local.issue",
				"title": "%command.codesight.lockIssue%",
				"when": "codesight.setupComplete && codesight.editorMarkersEnabled",
				"icon": {
					"dark": "resources/icons/general/lock-dark.svg",
					"light": "resources/icons/general/lock-light.svg"
				}
			},
			{
				"command": "codesight.lock.remote.issue",
				"title": "%command.codesight.lockIssue%",
				"when": "codesight.setupComplete && codesight.editorMarkersEnabled",
				"icon": {
					"dark": "resources/icons/general/lock-dark.svg",
					"light": "resources/icons/general/lock-light.svg"
				}
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "codesight",
					"title": "%view.codesight.title%",
					"icon": "resources/icons/blackduck-hollow.svg"
				}
			]
		},
		"views": {
			"codesight": [
				{
					"id": "codesight-local-view",
					"name": "%view.local.view.title%",
					"when": "codesight.setupComplete"
				},
				{
					"id": "codesight-team-view",
					"name": "%view.team.view.title%",
					"when": "codesight.setupComplete"
				},
				{
					"id": "codesight-status-view",
					"name": "%view.status.title%",
					"when": "codesight.setupComplete"
				},
				{
					"id": "codesight-setup-status",
					"name": "%view.setup.title%",
					"visibility": "collapsed",
					"when": "!codesight.setupComplete"
				},
				{
					"id": "codesight-help-view",
					"name": "%view.help.title%",
					"visibility": "collapsed",
					"type": "webview"
				}
			]
		},
		"menus": {
			"editor/title": [
				{
					"command": "codesight.show.local.view.markers",
					"group": "navigation@1",
					"when": "codesight.setupComplete && !codesight.localViewMarkers && resourceScheme == file && codesight.editorMarkersEnabled && codesight.isEditorMarkersEnabledFromSettings && codesight.hasLocalViewResults"
				},
				{
					"command": "codesight.show.team.view.markers",
					"group": "navigation@1",
					"when": "codesight.setupComplete && codesight.localViewMarkers && resourceScheme == file && codesight.editorMarkersEnabled && codesight.isEditorMarkersEnabledFromSettings && codesight.hasTeamViewResults"
				}
			],
			"view/title": [
				{
					"command": "codesight.openAutoScanConfig",
					"when": "view == codesight-local-view && codesight.scanMode == 'auto'",
					"group": "1"
				},
				{
					"command": "codesight.openAutoScanConfig",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.aiEnabled",
					"group": "1"
				},
				{
					"command": "codesight.openScanConfig",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && !codesight.aiEnabled",
					"group": "1"
				},
				{
					"command": "codesight.local.view.issues.restore.full.list",
					"when": "view == codesight-local-view && codesight.localViewSimpleView",
					"group": "navigation@1"
				},
				{
					"command": "codesight.local.view.search",
					"when": "view == codesight-local-view",
					"group": "navigation@1"
				},
				{
					"command": "codesight.local.view.export.results",
					"when": "view == codesight-local-view && codesight.setupComplete && codesight.scanMode == 'manual' && codesight.hasExportableResultsFile",
					"group": "2"
				},
				{
					"command": "codesight.local.view.export.results.disabled.not.manual",
					"when": "view == codesight-local-view && codesight.setupComplete && codesight.scanMode != 'manual'",
					"group": "2"
				},
				{
					"command": "codesight.local.view.export.results.disabled.unsupported.scan.type",
					"when": "view == codesight-local-view && codesight.setupComplete && codesight.scanMode == 'manual' && !codesight.isScanTypeSupported",
					"group": "2"
				},
				{
					"command": "codesight.local.view.export.results.disabled.no.results",
					"when": "view == codesight-local-view && codesight.setupComplete && codesight.scanMode == 'manual' && codesight.isScanTypeSupported && !codesight.hasExportableResultsFile",
					"group": "2"
				},
				{
					"command": "codesight.local.view.scan",
					"when": "view == codesight-local-view && !codesight.localViewManualScanRunning && codesight.scanMode == 'manual' && !codesight.aiEnabled",
					"group": "navigation@3"
				},
				{
					"command": "codesight.local.view.cancel.scan",
					"when": "view == codesight-local-view && codesight.localViewManualScanRunning && codesight.scanMode == 'manual' && !codesight.aiEnabled",
					"group": "navigation@3"
				},
				{
					"command": "codesight.local.view.issues.sort.select",
					"when": "view == codesight-local-view && !codesight.localViewScanRunning && codesight.scanMode == 'manual' && codesight.local.view.sort.visible",
					"group": "navigation@2"
				},
				{
					"command": "codesight.openLocalViewFilterView.filtersApplied",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.showLocalViewFilter && codesight.hasLocalViewFiltersApplied && !codesight.signalView",
					"group": "navigation@2"
				},
				{
					"command": "codesight.openLocalViewFilterView.noFiltersApplied",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.showLocalViewFilter && !codesight.hasLocalViewFiltersApplied && !codesight.signalView",
					"group": "navigation@2"
				},
				{
					"command": "codesight.localViewFilterView.disableActiveFileFilter",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.showLocalViewFilter && codesight.editorMarkersEnabled && codesight.hasLocalViewActiveFileFilter && !codesight.aiEnabled",
					"group": "navigation@2"
				},
				{
					"command": "codesight.localViewFilterView.enableActiveFileFilter",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.showLocalViewFilter && codesight.editorMarkersEnabled && !codesight.hasLocalViewActiveFileFilter && !codesight.aiEnabled",
					"group": "navigation@2"
				},
				{
					"command": "codesight.ai.enable",
					"when": "view == codesight-local-view && codesight.signalView && codesight.scanMode == 'auto' && !codesight.aiEnabled",
					"group": "navigation@3"
				},
				{
					"command": "codesight.ai.disable",
					"when": "view == codesight-local-view && codesight.signalView && codesight.aiEnabled",
					"group": "navigation@3"
				},
				{
					"command": "codesight.signal.view.refresh",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.aiEnabled && !codesight.localViewSignalScanRunning",
					"group": "navigation@1"
				},
				{
					"command": "codesight.signal.view.cancel",
					"when": "view == codesight-local-view && codesight.scanMode == 'manual' && codesight.aiEnabled && codesight.localViewSignalScanRunning",
					"group": "navigation@1"
				},
				{
					"command": "codesight.sigma.changed.file.refresh",
					"when": "view == codesight-local-view && codesight.scanMode == 'auto' && codesight.scanFilesScopeChangedFiles && !codesight.localViewSigmaChangedFileScanRunning",
					"group": "navigation@1"
				},
				{
					"command": "codesight.sigma.changed.file.cancel",
					"when": "view == codesight-local-view && codesight.scanMode == 'auto' && codesight.scanFilesScopeChangedFiles && codesight.localViewSigmaChangedFileScanRunning",
					"group": "navigation@1"
				},
				{
					"command": "codesight.scan.disabled",
					"when": "view == codesight-local-view && !codesight.localViewScanRunning && codesight.scanMode == 'auto' && !codesight.signalView",
					"group": "navigation@3"
				},
				{
					"command": "codesight.openHelp",
					"when": "view == codesight-extension-status || view == codesight-setup-status",
					"group": "navigation"
				},
				{
					"command": "codesight.configure",
					"when": "view == codesight-extension-status",
					"group": "navigation"
				},
				{
					"command": "codesight.openTeamViewIssueSourceView",
					"when": "view == codesight-team-view",
					"group": "navigation@4"
				},
				{
					"command": "codesight.team.view.issues.restore.full.list",
					"when": "view == codesight-team-view && codesight.teamViewSimpleView",
					"group": "navigation@1"
				},
				{
					"command": "codesight.refresh.remote",
					"when": "view == codesight-team-view && codesight.issueSourceSelected",
					"group": "navigation"
				},
				{
					"command": "codesight.sort.team.view.issues",
					"when": "view == codesight-team-view && codesight.team.view.issue.sort.visible",
					"group": "navigation@3"
				},
				{
					"command": "codesight.openTeamViewFilterView.filtersApplied",
					"when": "view == codesight-team-view && codesight.issueSourceSelected && codesight.showTeamViewFilter && codesight.hasFiltersApplied",
					"group": "navigation@2"
				},
				{
					"command": "codesight.openTeamViewFilterView.noFiltersApplied",
					"when": "view == codesight-team-view && codesight.issueSourceSelected && codesight.showTeamViewFilter && !codesight.hasFiltersApplied",
					"group": "navigation@2"
				},
				{
					"command": "codesight.teamViewFilterView.disableActiveFileFilter",
					"when": "view == codesight-team-view && codesight.issueSourceSelected && codesight.editorMarkersEnabled && codesight.teamViewServerTypeSupportsActiveFileFilter && codesight.hasActiveFileFilter",
					"group": "navigation@1"
				},
				{
					"command": "codesight.teamViewFilterView.enableActiveFileFilter",
					"when": "view == codesight-team-view && codesight.issueSourceSelected && codesight.editorMarkersEnabled && codesight.teamViewServerTypeSupportsActiveFileFilter && !codesight.hasActiveFileFilter",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "codesight.copyTreeItem",
					"when": "viewItem != codesight:copyAllIssues"
				},
				{
					"command": "codesight.copyAllIssues",
					"when": "viewItem =~ /codesight:.*copyAllIssues.*/"
				},
				{
					"command": "codesight.diffSource.all",
					"when": "view == codesight-local-view && viewItem =~ /(?!.*selectedDiffSourceAll.*)codesight:.*scopeState.*/",
					"group": "inline@1"
				},
				{
					"command": "codesight.diffSource.new",
					"when": "view == codesight-local-view && viewItem =~ /(?!.*selectedDiffSourceNew.*)codesight:.*scopeState.*/",
					"group": "inline@3"
				},
				{
					"command": "codesight.diffSource.fixed",
					"when": "view == codesight-local-view && viewItem =~ /(?!.*selectedDiffSourceFixed.*)codesight:.*scopeState.*/",
					"group": "inline@2"
				},
				{
					"command": "codesight.diffSource.all.pressed",
					"when": "view == codesight-local-view && viewItem =~ /codesight:.*scopeState.*/ && viewItem =~ /codesight:.*selectedDiffSourceAll.*/",
					"group": "inline@1"
				},
				{
					"command": "codesight.diffSource.new.pressed",
					"when": "view == codesight-local-view && viewItem =~ /codesight:.*scopeState.*/ && viewItem =~ /codesight:.*selectedDiffSourceNew.*/",
					"group": "inline@3"
				},
				{
					"command": "codesight.diffSource.fixed.pressed",
					"when": "view == codesight-local-view && viewItem =~ /codesight:.*scopeState.*/ && viewItem =~ /codesight:.*selectedDiffSourceFixed.*/",
					"group": "inline@2"
				},
				{
					"command": "codesight.inverseSortUp",
					"when": "viewItem =~ /codesight:.*sortStateUp.*/",
					"group": "inline"
				},
				{
					"command": "codesight.inverseSortDown",
					"when": "viewItem =~ /codesight:.*sortStateDown.*/",
					"group": "inline"
				},
				{
					"command": "codesight.clearSourceFilter",
					"when": "viewItem =~ /codesight:.*(sourceFilter).*/",
					"group": "inline"
				},
				{
					"command": "codesight.local.view.clearSearchFilter",
					"when": "viewItem =~ /codesight:.*(search).*/ && view == codesight-local-view",
					"group": "inline"
				},
				{
					"command": "codesight.cancelJob",
					"when": "viewItem =~ /codesight:.*cancellableScanJob.*/",
					"group": "inline"
				},
				{
					"command": "codesight.openSetup",
					"when": "viewItem =~ /codesight:.*openOnboarding.*/",
					"group": "inline"
				},
				{
					"command": "codesight.edit.polaris.server.info",
					"when": "viewItem =~ /codesight:.*editPolarisServerInfo.*/",
					"group": "inline"
				},
				{
					"command": "codesight.edit.srm.server.info",
					"when": "viewItem =~ /codesight:.*editSRMServerInfo.*/",
					"group": "inline"
				},
				{
					"command": "codesight.edit.coverity.server.info",
					"when": "viewItem =~ /codesight:.*editCoverityServerInfo.*/",
					"group": "inline"
				},
				{
					"command": "codesight.edit.black.duck.server.info",
					"when": "viewItem =~ /codesight:.*editBlackDuckServerInfo.*/",
					"group": "inline"
				},
				{
					"command": "codesight.view.local.view.scan.details",
					"when": "viewItem =~ /codesight:.*viewLocalViewScanDetails.*/",
					"group": "inline"
				},
				{
					"command": "codesight.export.logs",
					"when": "viewItem =~ /codesight:.*exportLogs.*/",
					"group": "inline"
				},
				{
					"command": "codesight.open.remote.issue.list.error",
					"when": "viewItem =~ /codesight:.*viewRemoteErrorDetails.*/",
					"group": "inline"
				},
				{
					"command": "codesight.open.local.issue.list.error",
					"when": "viewItem =~ /codesight:.*viewRemoteErrorDetails.*/",
					"group": "inline"
				},
				{
					"command": "codesight.lock.local.issue",
					"when": "view == codesight-local-view && viewItem =~ /codesight:.*lockLocalIssueItem.*/ && !codesight.localViewSimpleView && codesight.scanMode == 'manual' && codesight.editorMarkersEnabled",
					"group": "inline"
				},
				{
					"command": "codesight.lock.remote.issue",
					"when": "view == codesight-team-view && viewItem =~ /codesight:.*lockRemoteIssueItem.*/ && !codesight.teamViewSimpleView && codesight.editorMarkersEnabled",
					"group": "inline"
				}
			],
			"commandPalette": [
				{
					"command": "codesight.copyTreeItem",
					"when": "false"
				},
				{
					"command": "codesight.copyAllIssues",
					"when": "false"
				},
				{
					"command": "codesight.open.remote.issue.list.error",
					"when": "false"
				},
				{
					"command": "codesight.open.local.issue.list.error",
					"when": "false"
				},
				{
					"command": "codesight.local.view.clearSearchFilter",
					"when": "false"
				},
				{
					"command": "codesight.clearSourceFilter",
					"when": "false"
				},
				{
					"command": "codesight.inverseSortUp",
					"when": "false"
				},
				{
					"command": "codesight.inverseSortDown",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.all",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.all.pressed",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.new",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.new.pressed",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.fixed",
					"when": "false"
				},
				{
					"command": "codesight.diffSource.fixed.pressed",
					"when": "false"
				},
				{
					"command": "codesight.cancelJob",
					"when": "false"
				},
				{
					"command": "codesight.local.view.scan",
					"when": "false"
				},
				{
					"command": "codesight.scan.disabled",
					"when": "false"
				},
				{
					"command": "codesight.turn.off.auto.mode",
					"when": "false"
				},
				{
					"command": "codesight.turn.on.auto.mode",
					"when": "false"
				},
				{
					"command": "codesight.local.view.cancel.scan",
					"when": "false"
				},
				{
					"command": "codesight.local.view.issues.sort.select",
					"when": "false"
				},
				{
					"command": "codesight.sort.team.view.issues",
					"when": "false"
				},
				{
					"command": "codesight.teamViewFilterView.enableActiveFileFilter",
					"when": "false"
				},
				{
					"command": "codesight.teamViewFilterView.disableActiveFileFilter",
					"when": "false"
				},
				{
					"command": "codesight.localViewFilterView.enableActiveFileFilter",
					"when": "false"
				},
				{
					"command": "codesight.localViewFilterView.disableActiveFileFilter",
					"when": "false"
				},
				{
					"command": "codesight.openTeamViewFilterView.filtersApplied",
					"when": "codesight.setupComplete && codesight.showTeamViewFilter && codesight.issueSourceSelected && codesight.hasFiltersApplied"
				},
				{
					"command": "codesight.openTeamViewFilterView.noFiltersApplied",
					"when": "codesight.setupComplete && codesight.showTeamViewFilter && codesight.issueSourceSelected && !codesight.hasFiltersApplied"
				}
			]
		},
		"configuration": {
			"title": "%view.codesight.title%",
			"properties": {
				"codeSight.telemetry.enablement": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"markdownDescription": "%config.codeSight.telemetry.enablement%",
					"description": "%config.codeSight.telemetry.enablement%"
				},
				"codeSight.markers.enablement": {
					"type": "boolean",
					"default": true,
					"description": "%config.codeSight.markers.enablement%"
				},
				"codeSight.markers.highlighting.issueUnderlineColor": {
					"type": "string",
					"default": "rgba(146, 135, 218, 1)",
					"markdownDescription": "%config.codeSight.markers.highlighting.issueUnderlineColor%",
					"description": "%config.codeSight.markers.highlighting.issueUnderlineColor%"
				},
				"codeSight.markers.highlighting.newIssueUnderlineColor": {
					"type": "string",
					"default": "rgba(248, 128, 112, 1)",
					"markdownDescription": "%config.codeSight.markers.highlighting.newIssueUnderlineColor%",
					"description": "%config.codeSight.markers.highlighting.newIssueUnderlineColor%"
				},
				"codeSight.warnings.showAll": {
					"type": "boolean",
					"scope": "application",
					"default": true,
					"description": "Show all warning pop-ups (e.g. Workspace Is Empty, Custom Build Command Not Found, and so on)"
				},
				"codeSight.scan.tool.configuration": {
					"type": "string",
					"default": "%config.codeSight.click.link.in.description%",
					"enum": [
						"%config.codeSight.click.link.in.description%"
					],
					"enumDescriptions": [
						"%config.codeSight.scan.tool.configuration.description%"
					],
					"markdownDescription": "You can configure which scan engines Code Sight will use to scan your code, and customize incremental scan settings, in the [Code Sight Incremental Scan Config window](command:codesight.openAutoScanConfig)"
				},
				"codeSight.config.settings": {
					"type": "string",
					"default": "%config.codeSight.settings.link.desc%",
					"enum": [
						"%config.codeSight.settings.link.desc%"
					],
					"enumDescriptions": [
						"%config.codeSight.settings.enum.desc%"
					],
					"markdownDescription": "%config.codeSight.settings.markdown%"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"compile": "gulp lintChecks && tsc -p ./tsconfig.json && tsc-alias -p ./tsconfig.json",
		"watch": "tsc -watch -p ./tsconfig.json && tsc-alias -p ./tsconfig.json",
		"coverage": "gulp compile && gulp prepareTestWorkspace && gulp cover:clean && gulp rename-dist",
		"prepare-test-workspace": "gulp prepareTestWorkspace",
		"webpack": "gulp lintChecks && webpack --mode development",
		"webpack-no-lint": "gulp header-copyright && webpack --mode development",
		"pre-test": "npm run compile && gulp rename-dist && gulp prepareTestWorkspace",
		"post-test": "gulp restore-dist",
		"postinstall": "cd webview-ui && npm install && cd ..",
		"prepare": "husky install"
	},
	"lint-staged": {
		"*.ts": "eslint"
	},
	"dependencies": {
		"@codesight/codesight-controller": "2026.4.0-6",
		"@codesight/codesight-controller-proto": "2026.4.0-1",
		"@grpc/grpc-js": "1.3.2",
		"@types/google-protobuf": "3.15.7",
		"@types/vscode": "^1.90.0",
		"@vscode/codicons": "^0.0.33",
		"@vscode/test-electron": "2.4.1",
		"child_process": "^1.0.2",
		"fs-extra": "^11.1.1",
		"google-protobuf": "3.21.2",
		"markdown-it": "^10.0.0",
		"mkdirp": "^0.5.1",
		"moment": "2.24.0",
		"node-dependency-injection": "2.7.0",
		"prex": "0.4.6",
		"source-map-support": "^0.5.16",
		"tabulator-tables": "5.4.3",
		"tmp": "^0.2.1",
		"tsc-alias": "^1.8.8",
		"typescript-collections": "1.3.3",
		"vscode-languageclient": "^7.0.0",
		"vscode-nls": "4.1.1",
		"winston": "3.3.4"
	},
	"devDependencies": {
		"@types/chai": "4.2.7",
		"@types/fs-extra": "^8.0.1",
