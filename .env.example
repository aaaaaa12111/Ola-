# OLA Builder Agent v0.1 Configuration

# Application
APP_NAME=OLA Builder Agent
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database (SQLite for MVP, PostgreSQL migration ready)
DATABASE_URL=sqlite:///./ola_builder.db
# DATABASE_URL=postgresql://user:password@localhost/ola_builder  # for production

# Memory & Storage
STORAGE_PATH=./data
MEMORY_BACKEND=sqlite

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Agents Configuration
ENABLE_REQUIREMENT_AGENT=True
ENABLE_PLANNER_AGENT=True
ENABLE_CODE_AGENT=True
ENABLE_TEST_AGENT=True
ENABLE_REVIEW_AGENT=True
ENABLE_DOCS_AGENT=True

# Logging
LOG_FORMAT=json
LOG_FILE=./logs/ola_builder.log
